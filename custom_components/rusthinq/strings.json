{
  "config": {
    "step": {
      "user": {
        "title": "rusthinq",
        "menu_options": {
          "embedded": "Run rusthinq in Home Assistant",
          "migrate": "Move an existing rusthinq into Home Assistant"
        }
      },
      "embedded": {
        "title": "Run rusthinq in Home Assistant",
        "description": "Home Assistant downloads and runs the rusthinq daemon, which LG ThinQ appliances connect to on this host. Appliances open HTTPS on port 443, and appliances already registered with LG open MQTT on 8883. If a port here differs, redirect 443 or 8883 to it.",
        "data": {
          "https_port": "HTTPS port",
          "mqtt_port": "MQTT port"
        },
        "data_description": {
          "https_port": "Where appliances are provisioned and register (443 unless a redirect points here)",
          "mqtt_port": "Appliances open 8883, and rusthinq tells them 8883 whatever port this is; redirect 8883 to this port if it differs"
        }
      },
      "migrate": {
        "title": "Move an existing rusthinq into Home Assistant",
        "description": "Keeps the CA your appliances trust, their device records, the LG account and the settings appliances notice, so nothing needs provisioning again. Where should the backup come from?",
        "menu_options": {
          "migrate_fetch": "Copy it from the running rusthinq",
          "migrate_upload": "Upload a backup file"
        }
      },
      "migrate_fetch": {
        "title": "Copy from the running rusthinq",
        "description": "Home Assistant downloads the backup from the old rusthinq's management API (rusthinq 0.2.0 or later). rusthinq hands it out only when its management API has a user and password or listens on loopback only, since it holds the CA key and LG tokens.",
        "data": {
          "url": "URL",
          "username": "Username",
          "password": "Password"
        },
        "data_description": {
          "url": "Base URL of the old rusthinq's management API, for example http://192.168.1.10:44401",
          "username": "`[management] user`, if it has one",
          "password": "`[management] password`"
        }
      },
      "migrate_upload": {
        "title": "Upload a backup",
        "description": "Take a backup on the old host with the dashboard (System → Download backup) or `sudo thinqctl backup`, and upload it here.\n\nWithout either, archive config.toml with the files it names, in its directory, for example:\n`tar czf rusthinq-export.tar.gz config.toml ca.key ca.cert devices.json account.json account.json.pairings`",
        "data": {
          "archive": "Backup"
        },
        "data_description": {
          "archive": "rusthinq-backup-….tar, or a .tar.gz of config.toml and the files it names"
        }
      },
      "migrate_confirm": {
        "title": "Move this rusthinq in",
        "description": "The backup holds:\n- host name: **{hostname}**\n- devices: **{devices}**\n- LG account: **{account}**\n- written by rusthinq {rusthinq} at {created}\n\nExisting files that differ from this backup: **{conflicts}**\nOverwriting the CA may mean provisioning appliances again. Only files included in the backup are replaced; files absent from it are kept.\n\n1. **Stop rusthinq on the old host now**, and keep it stopped: both would answer the same appliances and LG account.\n2. Check the ports, filled in with the old installation's, and submit.\n3. Point the appliances' route (DNS or redirect) at this host.",
        "data": {
          "https_port": "HTTPS port",
          "mqtt_port": "MQTT port",
          "thinq1_https_port": "ThinQ1 HTTPS port",
          "thinq1_port": "ThinQ1 port",
          "overwrite_existing": "Overwrite conflicting files included in the backup"
        },
        "data_description": {
          "https_port": "Where appliances are provisioned and register (443 unless a redirect points here)",
          "mqtt_port": "Appliances open 8883, and rusthinq tells them 8883 whatever port this is; redirect 8883 to this port if it differs"
        }
      }
    },
    "error": {
      "cannot_connect": "Could not reach the management API.",
      "invalid_auth": "The management API rejected the username or password.",
      "duplicate_ports": "Each listener needs its own port.",
      "ports_unavailable": "These ports cannot be used: {problems}",
      "invalid_archive": "The backup cannot be imported: {problems}",
      "overwrite_required": "Select the confirmation box to overwrite. Files not included in the backup will not be deleted.",
      "backup_refused": "rusthinq refused the backup: {problems}",
      "backup_unsupported": "This rusthinq cannot hand out a backup (it needs 0.2.0 or later). Upload a file instead.",
      "source_running": "The old rusthinq at {problems} still answers. Stop it first."
    },
    "abort": {
      "already_configured": "rusthinq is already set up."
    }
  },
  "issues": {
    "ports_unavailable": {
      "title": "rusthinq cannot open its ports",
      "description": "The built-in rusthinq cannot start: {problems}.\n\nFree the port, or choose other ports by removing the integration and adding it again (the CA and devices stay in /config/rusthinq, so nothing is lost). Appliances always open HTTPS on 443, and appliances already registered with LG open MQTT on 8883; if rusthinq listens elsewhere, redirect those ports to it. rusthinq keeps retrying on its own."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "LG account",
        "description": "rusthinq is {state}. Last error: {error}.\n\nThe LG account lets rusthinq name your appliances and keep the LG ThinQ app working through its per-device bridge.",
        "menu_options": {
          "login": "Sign in to LG",
          "logout": "Sign out",
          "refresh": "Sign in again with the saved credentials",
          "reset": "Reset rusthinq data",
          "backup": "Download a backup"
        }
      },
      "login": {
        "title": "Sign in to LG",
        "description": "rusthinq asks LG for a sign-in page for this country.",
        "data": {
          "country": "Country"
        },
        "data_description": {
          "country": "Two-letter country code of the LG account, e.g. KR or US"
        }
      },
      "login_complete": {
        "title": "Sign in to LG",
        "description": "1. Open [LG's sign-in page]({sign_in_url}) and sign in.\n2. The browser ends on a blank page whose address starts with https://…/login/iabClose. Copy that whole address.\n3. Paste it here.",
        "data": {
          "url": "Address after signing in"
        }
      },
      "logout": {
        "title": "Sign out of LG",
        "description": "rusthinq forgets the LG credentials. Bridged devices disconnect from LG until you sign in again; local control is unaffected."
      },
      "reset": {
        "title": "Reset rusthinq data",
        "description": "This removes the CA, device records, LG account, retained topics, and saved daemon settings. Appliances may need to be provisioned again. Download a backup first if you may need this data.",
        "data": {
          "confirm_reset": "I understand; erase rusthinq data and create a new CA"
        }
      }
    },
    "error": {
      "cloud_failed": "rusthinq could not do that: {problem}",
      "reset_required": "Select the confirmation box to reset rusthinq."
    },
    "abort": {
      "no_bridge": "This rusthinq has no LG bridge.",
      "cloud_failed": "rusthinq could not do that: {problem}",
      "reset_failed": "rusthinq could not be restarted after reset.",
      "backup": "[Open the backup page]({page}) to download a portable backup of rusthinq: the CA, the device records and the LG account. Only administrators can open it."
    }
  },
